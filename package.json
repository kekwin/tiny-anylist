{
  "name": "tiny-anylist",
  "version": "0.1.0",
  "description": "Small unofficial TypeScript client for AnyList shopping lists (read lists, add, check, rename and remove items).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["anylist", "grocery", "shopping-list", "unofficial"],
  "license": "MIT",
  "author": "Kewin Sommer Pedersen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekwin/tiny-anylist.git"
  },
  "homepage": "https://github.com/kekwin/tiny-anylist#readme",
  "bugs": {
    "url": "https://github.com/kekwin/tiny-anylist/issues"
  }
}
